<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- VrGpu.cs: Direct3D 11 の COM を関数ポインタで直接呼ぶため -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms は使わない (トレイは TrayIcon.cs が Shell_NotifyIcon を直接呼ぶ)。
         自己完結 exe に WinForms 一式 (20MB 超) を同梱しないため -->
    <AssemblyName>VRCAvatarChanger</AssemblyName>
    <RootNamespace>VRCAvatarChanger</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- バージョンはここだけ変える -->
    <Version>1.1.1</Version>
    <Product>VRCAvatarChanger</Product>
    <AssemblyTitle>VRCAvatarChanger</AssemblyTitle>
    <Description>VRChat のアバターを外部から着替える Windows 用アプリ</Description>
    <Copyright>Copyright (c) 2026 VRCAvatarChanger contributors</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>

    <!-- 配布ビルド (publish.ps1 から使用): ランタイム同梱の単一 exe -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- SteamVR (OpenVR v2.15.6、github.com/ValveSoftware/openvr)。openvr_api.cs / openvr_api.dll / LICENSE は公式のまま置いている。
       dll は exe の隣に置き、単一 exe の発行では exe に同梱される (IncludeNativeLibrariesForSelfExtract) -->
  <ItemGroup>
    <None Include="OpenVR\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
