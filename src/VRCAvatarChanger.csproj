<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- タスクトレイ (NotifyIcon) 用 -->
    <!-- WFO0003: WinForms アナライザーが app.manifest の DPI 設定に反応するが、DPI は WPF が扱う (WinForms はトレイのみ) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>VRCAvatarChanger</AssemblyName>
    <RootNamespace>VRCAvatarChanger</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- バージョンはここだけ変える -->
    <Version>1.0.8</Version>
    <Product>VRCAvatarChanger</Product>
    <AssemblyTitle>VRCAvatarChanger</AssemblyTitle>
    <Description>VRChat のアバターを外部から着替える Windows 用アプリ</Description>
    <Copyright>Copyright (c) 2026 VRCAvatarChanger contributors</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>

    <!-- 配布ビルド (publish.ps1 から使用): ランタイム同梱の単一 exe -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms が足す暗黙 using は WPF の型 (Brush / Size / KeyEventArgs 等) と衝突するので外す。
         WinForms はトレイ (MainWindow.Tray.cs) だけがエイリアス経由で使う -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
