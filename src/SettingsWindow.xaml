<Window x:Class="VRCAvatarChanger.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="設定" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- オン/オフの状態が読めるトグル -->
        <Style x:Key="OnOffToggle" TargetType="ToggleButton" BasedOn="{StaticResource SegmentToggle}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Content" Value="オフ"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="オン"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <Border Style="{StaticResource SettingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VRChat 連動" Style="{StaticResource SettingTitle}"/>
                    <TextBlock Style="{StaticResource SettingDesc}"
                               Text="Windows 起動時にタスクトレイで待機し、VRChat の起動を検知したら自動でウィンドウを開きます。オンの間はウィンドウを閉じてもトレイに残ります(完全に終了するにはトレイアイコンを右クリック →「終了」)。"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" x:Name="WatchToggle" Style="{StaticResource OnOffToggle}"
                              Checked="WatchToggle_Changed" Unchecked="WatchToggle_Changed"
                              VerticalAlignment="Top" Margin="14,0,0,0" AutomationProperties.Name="VRChat 連動"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="データの保存先" Style="{StaticResource SettingTitle}"/>
                    <TextBlock Style="{StaticResource SettingDesc}"
                               Text="設定・グループ・タグ・パブリックリストの保存先フォルダ (%AppData%\VRCAvatarChanger) を開きます。"/>
                </StackPanel>
                <Button Grid.Column="1" Content="開く" Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click"
                        MinWidth="80" Height="32" VerticalAlignment="Top" Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <Button Content="閉じる" Click="Close_Click" MinWidth="100" Height="34" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
