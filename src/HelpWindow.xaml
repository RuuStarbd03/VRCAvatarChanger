<Window x:Class="VRCAvatarChanger.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VRCAvatarChanger"
        Style="{StaticResource {x:Type Window}}"
        Title="使い方" Width="640" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StepNo" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Q" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <!--
            よくある質問の 1 項目。質問だけを並べ、押したときに答えを開く。
            全文を出しっぱなしにすると目的の質問を探すまでが長いため。
        -->
        <Style x:Key="Faq" TargetType="Expander">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="8,11" CornerRadius="{StaticResource ControlRadius}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="chev" Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="10,0,2,0"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                                                    <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Margin="8,0,8,12" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 見出しタブ -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabHowTo" Content="使い方" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabFaq" Content="よくある質問" Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabAbout" Content="このアプリについて" Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20" local:SmoothScroll.IsEnabled="True">
            <Grid>
                <!-- ===== 使い方 ===== -->
                <StackPanel x:Name="HowToPanel" MaxWidth="620">
                    <TextBlock Text="VRChat を起動していなくても、外部からアバターを切り替えられます。" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                               Text="起動中なら即座に反映され、未起動の場合は次回 VRChat 起動時にそのアバターで開始します。"/>

                    <Border Style="{StaticResource Step}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="1" Style="{StaticResource StepNoText}"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VRChat アカウントでログイン" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="ユーザー名・パスワード、またはブラウザ連携（Discord / Google / Apple / Steam）からログインします。パスワード自体は保存されず、暗号化された認証セッションのみを保持します。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Step}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="2" Style="{StaticResource StepNoText}"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="アバターを選択" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="「自分のアバター」「お気に入り」「パブリック」の各タブから探します。右上の検索欄や、一覧上部のタグフィルタで絞り込みが可能です。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Step}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="3" Style="{StaticResource StepNoText}"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="アバターをチェンジ" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="右下の「選択したアバターにチェンジ」をクリックするか、アバターをダブルクリックします。画面左上の「現在:」が切り替われば完了です。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="パブリックタブ" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="気に入ったパブリックアバターをストックできる、本アプリ専用のリストです（登録数の上限はありません）。アバター ID や URL を入力して「追加」するか、他のタブで右クリックして「パブリックに追加」を選択してください。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="※削除や非公開になったアバターには「使用不可」の印が付きます。整理したい場合は、右クリック →「使用不可をまとめて外す...」で一括削除できます。"/>

                    <TextBlock Text="アバターの詳細" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="アバターを右クリック →「詳細を見る...」を選択すると、拡大画像、説明文、対応プラットフォーム、パフォーマンスランク、ダウンロードサイズ、アップロード日などを確認できます。衣装違いの見分けや、チェンジ前の確認に役立ちます。"/>

                    <TextBlock Text="お気に入り・タグ" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="アバターを右クリックすると、お気に入りの追加・解除や、タグの編集が行えます。設定したタグは一覧上部のフィルタに表示され、クリックひとつで絞り込めます。"/>

                    <TextBlock Text="グループ" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="衣装違いなどのバリエーションを1つにまとめられます。アバターを別のアバターにドラッグ＆ドロップするか、右クリック →「グループに入れる...」を選択してください。ツールバーのグループ化ボタンで表示の切り替えができ、ダブルクリックで中身を展開します。"/>

                    <TextBlock Text="ゲーム中にすばやくチェンジする (ホットキー)" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="VRChat プレイ中に Ctrl+Shift+1 を押すと、画面右側にアバター選択画面が表示されます。アバターをクリックすると即座に切り替わって選択画面が閉じ、VRChat にフォーカスが戻ります（※VRChat のウィンドウがアクティブなときのみ反応します）。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="設定 →「ホットキーの割り当て」から、このキーの変更や、以下の機能のショートカット割り当てが可能です。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="・直前のアバターに戻す&#x0a;・グループ内の次のアバターへ切り替え&#x0a;・特定のアバターを直接呼び出す（一覧でアバターを右クリックして割り当て）"/>

                    <TextBlock Text="ゲーム内のアバターチェンジを反映する (OSC)" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="VRChat 側で OSC を有効にすると（アクションメニュー → Options → OSC → Enabled）、ゲーム内でアバターチェンジした際も本アプリの「現在:」にリアルタイムで反映されます。OSC がオフの状態でも本アプリからのアバターチェンジは通常通り行えます。"/>

                    <TextBlock Text="キーボード操作" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="本アプリのウィンドウがアクティブなときに使用できるキーです（ゲーム内で使用するホットキーとは異なります）。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Enter: 選択したアバターにチェンジ / グループを開く&#x0a;Ctrl+I または Alt+Enter: 詳細を表示&#x0a;Ctrl+F: 検索欄へフォーカス (Enter で一覧へ戻る、Esc で入力を消去)&#x0a;Ctrl+1 / 2 / 3: 自分のアバター / お気に入り / パブリックタブへ切り替え&#x0a;Ctrl+Tab / Ctrl+Shift+Tab: 次 / 前のタブへ切り替え&#x0a;Ctrl+G: グループ化のオン / オフ&#x0a;Ctrl+Shift+L: リスト表示 / ボックス表示の切り替え&#x0a;Ctrl+C: アバター ID をコピー&#x0a;Ctrl+Z: 直前のグループ化を取り消し&#x0a;Delete: パブリックリストから削除 (確認ダイアログが表示されます)&#x0a;Esc / Backspace: グループ内から一覧へ戻る&#x0a;F5: 最新の情報に再読み込み&#x0a;Ctrl+,: 設定を開く&#x0a;F1: ヘルプ（この画面）を表示"/>
                </StackPanel>

                <!-- ===== FAQ ===== -->
                <StackPanel x:Name="FaqPanel" MaxWidth="620" Visibility="Collapsed">
                    <TextBlock Text="よくある質問" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" Text="項目を押すと答えが開きます。"/>

                    <Expander Style="{StaticResource Faq}" Header="チェンジしたのにゲーム内で変わらない">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="通常は数秒で反映されます。反映されない場合は、ゲーム内でクイックメニューを開閉するか、ワールドを移動（インスタンス移動）してみてください。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="「非公開アバターのため使用できません」と表示される">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="他のユーザーの非公開（Private）アバターには切り替えることができません（VRChat の仕様です）。ご自身のアカウントにアップロードされた非公開アバターであれば問題なく使用できます。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="パブリックタブに「使用不可」と表示されるアバターがある">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="そのアバターが削除されたか、作者によって非公開に変更されたため利用できなくなっています。誤検出を防ぐため、時間を空けて2回連続で確認できなかった場合のみ表示されます。リストから整理する場合は、右クリック →「使用不可をまとめて外す...」を選択してください。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="毎回ログインする手間を省きたい">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="「ブラウザでログイン」を使用すると、Discord / Google / Apple / Steam アカウントでログインできます。設定の「ブラウザのログイン状態を保持」をオンにしておけば、次回以降の手間を最小限に抑えられます。一度ログインすれば認証セッションが暗号化して保存されるため、毎回パスワードを入力する必要はありません。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="Discord や Google でログインできない">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="画面表示に「Microsoft Edge WebView2」が必要です（Windows 11 には標準搭載されています）。Google 側のセキュリティで拒否される場合は、VRChat 公式サイトでパスワードを設定した上で、ユーザー名とパスワードによるログインをお試しください。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="2段階認証コードはどこで確認できる？">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="認証アプリ（TOTP）を設定している場合はアプリに表示される6桁の数字を、設定していない場合は VRChat に登録したメールアドレス宛に届く認証コードを入力してください。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="お気に入りの「追加日」が実際の日時と違う">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="VRChat の仕様上、お気に入り登録日時が取得できないため、アバター自体の「アップロード日」を表示しています。なお、パブリックタブの追加日は「本アプリに登録した日時」が表示されます。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="一覧に「前回の一覧」と表示される / オフラインでも一覧が表示される">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="起動を高速化するため、キャッシュされている前回の一覧を先に表示し、バックグラウンドで最新情報を取得しています。通信できない環境では、取得日時を添えて前回のキャッシュデータを表示します。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="※取得から5分以内の一覧は再取得を行いません。すぐに最新化したい場合は F5 キーで再読み込みしてください。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="画面のテーマ（ライト / ダーク）を切り替えたい">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="設定 →「配色」から、システム / ライト / ダーク を選択できます。「システム」を選ぶと Windows のテーマ設定に連動します。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="アップロードしたアバターが一覧に見当たらない">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="以下の3点をご確認ください。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="1. グループの中に入っていないか（ツールバーのグループ化ボタンをオフにして確認）&#x0a;2. 検索欄の文字列やタグフィルタが適用されたままになっていないか&#x0a;3. F5 キーで再読み込みを実行したか（アップロード直後はキャッシュの更新が必要です）"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="セキュリティや保存データは安全？">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="パスワード自体は一切保存されません。保存されるのは、暗号化されたログインセッション、表示設定、パブリック一覧、グループ情報のみで、すべてお使いの PC 内に保存されます。通信先も VRChat 公式サーバーのみです。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="※共有 PC で使用する場合は、設定の「ブラウザのログイン状態を保持」をオフにし、利用終了時に「ログアウト」を行ってください。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="登録したデータはどこに保存される？（別 PC へのデータ移行）">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="%AppData%\VRCAvatarChanger フォルダに保存されています。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="別の PC にデータを引き継ぐ場合は、上記フォルダ内の以下の3ファイルをコピーしてください。&#x0a;・public_avatars.json（パブリック一覧）&#x0a;・groups.json（グループ設定）&#x0a;・tags.json（タグ設定）"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="※同フォルダ内の cache フォルダは一時データ（一覧・サムネイル）のため、移行する必要はありません。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="ログイン状態を完全に解除したい">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="設定 →「ログアウト」を実行すると、PC 内に保存された認証セッションが削除され、次回起動時はログイン画面が表示されます。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="不具合の報告方法やログの確認方法は？">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="設定 →「ログの記録」をオンにし、不具合を再現させた後、「開く」ボタンから app.log を確認してください。アバターチェンジの履歴や通信結果が時系列で記録されます（パスワードなどの認証情報は一切記録されません）。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="アプリのアップデート方法は？">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="新しいバージョンが配信されると、画面右上に更新ボタンが表示されます。ボタンをクリックするだけで、更新ファイルの適用から再起動まで自動で行われます。意図しないタイミングで自動更新されることはありません。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="アンインストール方法は？">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="アプリの実行ファイル（または解凍したフォルダ）を削除するだけで完了します。設定や登録データも完全に削除したい場合は、%AppData%\VRCAvatarChanger フォルダを手動で削除してください。"/>
                    </Expander>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="AboutPanel" MaxWidth="620" Visibility="Collapsed">
                    <TextBlock Text="VRCAvatarChanger" Style="{StaticResource H1}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Body}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                               Text="VRChat を起動せずに外部からアバターを切り替えられる Windows 向けツールです。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="※本アプリは非公式ツールです。VRChat 側の仕様変更により動作しなくなる場合があります。"/>
                    <TextBlock Text="保存先" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Body}" FontFamily="Cascadia Mono, Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="保存フォルダを開く" Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Height="32"/>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Margin" Value="0,0,16,6"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="public_avatars.json" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="パブリックタブの登録リスト"/>
                        <TextBlock Grid.Row="1" Text="groups.json / tags.json" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="グループ設定およびタグ設定"/>
                        <TextBlock Grid.Row="2" Text="settings.json" FontFamily="Cascadia Mono, Consolas"/>
