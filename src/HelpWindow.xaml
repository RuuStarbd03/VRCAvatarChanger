<Window x:Class="VRCAvatarChanger.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VRCAvatarChanger"
        Style="{StaticResource {x:Type Window}}"
        Title="使い方" Width="640" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StepNo" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Q" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <!--
            よくある質問の 1 項目。質問だけを並べ、押したときに答えを開く。
            全文を出しっぱなしにすると目的の質問を探すまでが長いため。
        -->
        <Style x:Key="Faq" TargetType="Expander">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="Transparent" Padding="8,11" CornerRadius="{StaticResource ControlRadius}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="chev" Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="10,0,2,0"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                                                    <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Margin="8,0,8,12" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 見出しタブ -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabHowTo" Content="使い方" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabFaq" Content="よくある質問" Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabAbout" Content="このアプリについて" Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20" local:SmoothScroll.IsEnabled="True">
            <Grid>
                <!-- ===== 使い方 ===== -->
                <StackPanel x:Name="HowToPanel" MaxWidth="620">
                    <TextBlock Text="VRChat を開かずにアバターを着替えられます" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                               Text="起動中ならすぐ切り替わります。起動していなければ、次に VRChat を開いたときにそのアバターになります。"/>

                    <Border Style="{StaticResource Step}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="1" Style="{StaticResource StepNoText}"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VRChat アカウントでログイン" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="ユーザー名とパスワード、またはブラウザからログインします (Discord / Google / Apple / Steam 連携はこちら)。パスワードは保存されません。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Step}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="2" Style="{StaticResource StepNoText}"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="アバターを選ぶ" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="「自分のアバター」「お気に入り」「パブリック」のタブから探します。右上の検索欄や、一覧の上のフィルタで絞り込めます。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Step}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="3" Style="{StaticResource StepNoText}"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="着替える" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                           Text="右下の「選択したアバターに着替える」を押すか、アバターをダブルクリックします。左上の「現在:」が変われば完了です。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="パブリックタブ" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="気に入ったパブリックアバターを溜めておく、このアプリ独自のリストです (上限なし)。ID や URL を貼って「追加」するか、他のタブで右クリック →「パブリックに追加」。"/>

                    <TextBlock Style="{StaticResource Body}"
                               Text="再読み込みのたびに登録したアバターを確かめ、削除されたり非公開になったりして着替えられなくなったものには「使えません」の印を付けます (一覧の末尾に寄せます)。自動では外さないので、右クリック →「使えなくなったものをまとめて外す...」か、詳細画面から外してください。"/>

                    <TextBlock Text="アバターの詳細" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="アバターを右クリック →「詳細を見る...」で、大きい画像・説明文・対応プラットフォーム・パフォーマンスランク・ダウンロードサイズ・日付をまとめて確認できます。似た衣装違いの見分けや、着替える前の確認に。"/>

                    <TextBlock Text="お気に入り・タグ" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="アバターを右クリックすると、お気に入りの追加・解除と、タグの編集ができます。付けたタグは一覧の上のフィルタに並び、ワンクリックで絞り込めます。"/>

                    <TextBlock Text="グループ" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="衣装違いなどを 1 つにまとめられます。アバターを別のアバターにドラッグ&amp;ドロップするか、右クリック →「グループに入れる...」。ツールバーのグループ化ボタンでまとめ表示を切り替え、ダブルクリックで中身を開きます。"/>

                    <TextBlock Text="ゲーム中にサッと着替える (ホットキー)" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="VRChat のプレイ中に Shift+1 を押すと、画面の右にアバター選択が出ます。クリックで着替えて閉じ、VRChat に操作が戻ります。反応するのは VRChat が手前のときだけです。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="設定 →「ホットキーの割り当て」で、このキーの変更と、次の 3 つの割り当てができます。"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="・直前のアバターに戻す&#x0a;・グループ内の次のアバター&#x0a;・特定のアバターを直接呼び出す(一覧で右クリック)"/>

                    <TextBlock Text="ゲーム内の着替えを反映する (OSC)" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="VRChat で OSC を有効にすると(アクションメニュー → Options → OSC → Enabled)、ゲーム内で着替えたときも左上の「現在:」が更新されます。無くても着替えはできます。"/>
                </StackPanel>

                <!-- ===== FAQ ===== -->
                <StackPanel x:Name="FaqPanel" MaxWidth="620" Visibility="Collapsed">
                    <TextBlock Text="よくある質問" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" Text="項目を押すと答えが開きます。"/>

                    <Expander Style="{StaticResource Faq}" Header="着替えたのにゲーム内で変わらない">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="通常は数秒で反映されます。変わらないときは、ゲーム内でメニューを開閉するか、ワールドを移動してみてください。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="「非公開アバターのため使用できません」と出る">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="他の人の非公開(Private)アバターには着替えられません(VRChat の仕様)。自分のアバターなら非公開でも使えます。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="パブリックタブに「使えません」と出るものがある">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="そのアバターが削除されたか、作者が非公開にしたため、着替えられなくなっています。誤検出を避けるため、時間を空けて 2 回続けて確認できなかったものだけをこう表示し、自動では外しません。非公開が一時的なら、次の再読み込みで印は消えます。外すときは右クリック →「使えなくなったものをまとめて外す...」。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="ログインが面倒 / いつものブラウザのログインを使いたい">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="「ふだん使うブラウザでログイン」を押すと、既定のブラウザで VRChat のページが開きます。ログイン済みなら token が表示されるので、コピーすれば自動で続行します。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="ブラウザに保存されたパスワードやクッキーを読むことはありません。受け取るのは、コピーした token だけです。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="Discord / Google でログインできない">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="ログイン画面の表示に WebView2 が必要です(Windows 11 には入っています)。Google に拒否される場合は、VRChat でパスワードを設定してユーザー名とパスワードでログインしてください。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="2 段階認証のコードはどこにある?">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="認証アプリを設定していればそのアプリの 6 桁のコード、していなければ VRChat に登録したメールアドレスに届くコードです。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="お気に入りの「追加日」は何の日付?">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="アバターがアップロードされた日です(VRChat はお気に入りに登録した日時を返さないため)。パブリックタブの「追加日」は、このアプリに追加した日です。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="一覧に「前回の一覧」と出る / オフラインでも一覧が出る">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="起動を速くするため、前回の一覧を先に表示してから裏で最新を取りに行きます。つながらないときは前回の一覧を、いつ時点のものかを添えて表示します。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="5 分以内に読み込んだ一覧は取り直しません。すぐ反映したいときは「再読み込み」(F5)を押してください。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="画面を明るく / 暗くしたい">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="「設定」→「配色」で システム / ライト / ダーク を選べます。「システム」は Windows の設定に追従します。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="アップロードしたアバターが 1 体だけ見当たらない">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="グループにまとまっていないか確かめてください。グループに入れたアバターは 1 枚のタイルにまとまります(ツールバーのグループ化をオフにすると個別に並びます)。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="次に、検索欄やフィルタが残っていないか確かめ、「再読み込み」(F5)を試してください。アップロード直後は F5 が必要なことがあります。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="何を保存している? 安全?">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="パスワードは保存しません。保存するのはログイン状態・表示設定・パブリックリスト・グループだけで、すべてこの PC の中です。ログイン状態は Windows の機能で暗号化され、通信先は VRChat のサーバーだけです。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="ログイン状態はアカウント全体を操作できるものなので、共用 PC では「ブラウザのログイン状態を保持」をオフにし、使い終わったら「ログアウト」してください。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="パブリックタブやグループの登録はどこに保存される?">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="%AppData%\VRCAvatarChanger の public_avatars.json(パブリック)、groups.json(グループ)、tags.json(タグ)です。別の PC に移すときはこの 3 つをコピーしてください。"/>
                            <TextBlock Style="{StaticResource Body}"
                                       Text="同じ場所の cache フォルダは一覧とサムネイルの控えです。消しても次回に取り直すだけです。"/>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="ログインしたままにしたくない">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="「設定」→「ログアウト」で保存されたログイン状態が消え、次回は再ログインになります。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="アップデートはどうやるの?">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="新しいバージョンが公開されると右上に更新ボタンが出ます。押すと差し替えから再起動まで自動で行われます。勝手に更新されることはありません。"/>
                    </Expander>

                    <Expander Style="{StaticResource Faq}" Header="アンインストールするには">
                        <TextBlock Style="{StaticResource Body}"
                                   Text="exe(または解凍したフォルダ)を削除するだけです。保存データも消す場合は %AppData%\VRCAvatarChanger フォルダを削除してください。"/>
                    </Expander>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="AboutPanel" MaxWidth="620" Visibility="Collapsed">
                    <TextBlock Text="VRCAvatarChanger" Style="{StaticResource H1}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Body}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                               Text="VRChat のアバターを外部から着替える Windows 用アプリです。VRChat 公式ではありません。VRChat の仕様変更で動かなくなることがあります。"/>
                    <TextBlock Text="保存先" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Body}" FontFamily="Cascadia Mono, Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="保存フォルダを開く" Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Height="32"/>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Margin" Value="0,0,16,6"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="public_avatars.json" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="パブリックタブの登録リスト"/>
                        <TextBlock Grid.Row="1" Text="groups.json / tags.json" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="グループとタグ"/>
                        <TextBlock Grid.Row="2" Text="settings.json" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="表示形式・並び順・ウィンドウ位置などの設定"/>
                        <TextBlock Grid.Row="3" Text="session.json" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="VRChat のログイン状態(暗号化済み。他の PC では使えない)"/>
                        <TextBlock Grid.Row="4" Text="error.log" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="予期しないエラーの記録(起きたときだけ)"/>
                        <TextBlock Grid.Row="5" Text="WebView2\" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Discord / Google ログイン用ブラウザの一時データ"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="別の PC に引き継ぐときは public_avatars.json と groups.json をコピーしてください。パスワードはどこにも保存していません。"/>
                    <TextBlock Text="使用技術" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}" Text=".NET / WPF、Microsoft Edge WebView2(連携ログイン用)、VRChat Web API、VRChat OSC"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
