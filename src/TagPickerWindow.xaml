<Window x:Class="VRCAvatarChanger.TagPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="タグを編集" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="SubjectText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

        <StackPanel x:Name="TagListPanel" Margin="0,0,0,4">
            <TextBlock Text="タグ (チェックしたものが付きます)" Style="{StaticResource FieldLabel}"/>
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}" Padding="10,8" MaxHeight="240" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TagList"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <TextBlock Text="新しいタグを追加" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTagBox" KeyDown="NewTagBox_KeyDown"/>
            <Button Grid.Column="1" Content="追加" Style="{StaticResource SecondaryButton}" Click="AddTag_Click" Margin="8,0,0,0" MinWidth="70"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="保存する" Click="Ok_Click" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
