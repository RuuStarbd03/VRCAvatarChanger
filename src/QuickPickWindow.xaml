<Window x:Class="VRCAvatarChanger.QuickPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="クイック着替え" Width="380"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="QuickRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource ControlRadius}" Padding="8,6" Margin="0,1" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 右端からのスライドは、透明ウィンドウの中でパネルを動かして表現する -->
    <Border x:Name="Root" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1,0,0,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SortBox" MinWidth="168" SelectionChanged="SortBox_SelectionChanged" ToolTip="並び順">
                    <ComboBoxItem Tag="recent"       Content="最近使用した順"/>
                    <ComboBoxItem Tag="created_desc" Content="追加日 (新しい順)"/>
                    <ComboBoxItem Tag="created_asc"  Content="追加日 (古い順)"/>
                    <ComboBoxItem Tag="updated_desc" Content="更新日 (新しい順)"/>
                    <ComboBoxItem Tag="updated_asc"  Content="更新日 (古い順)"/>
                    <ComboBoxItem Tag="name_asc"     Content="名前 (A → Z)"/>
                    <ComboBoxItem Tag="name_desc"    Content="名前 (Z → A)"/>
                </ComboBox>
                <TextBlock Grid.Column="1" Text="Shift+1 / Esc で閉じる" Style="{StaticResource CaptionText}" Foreground="{DynamicResource FaintTextBrush}"
                           VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="Close_Click" AutomationProperties.Name="閉じる"
                        ToolTip="閉じる (Esc)" Width="28" Height="28" Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="8,5"/>
                <TextBlock x:Name="SearchHint" Text="名前・作者で絞り込み" Style="{StaticResource MutedText}"
                           Foreground="{DynamicResource FaintTextBrush}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>

            <ListBox Grid.Row="2" x:Name="List" ItemContainerStyle="{StaticResource QuickRow}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseLeftButtonUp="List_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="42" CornerRadius="4" Background="{DynamicResource ThumbBackBrush}">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,56,42" RadiusX="4" RadiusY="4"/>
                                </Border.Clip>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AuthorName}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="現在のアバター"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,8,2,0"/>
        </Grid>
    </Border>
</Window>
