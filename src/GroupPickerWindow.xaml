<Window x:Class="VRCAvatarChanger.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="グループに割り当て" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="GroupItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,7" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="SubjectText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

        <StackPanel x:Name="ExistingPanel">
            <TextBlock Text="既存のグループ" Style="{StaticResource FieldLabel}"/>
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}" Padding="0,4" MaxHeight="220" Margin="0,0,0,14">
                <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GroupItem}"
                         SelectionChanged="GroupList_SelectionChanged" MouseDoubleClick="GroupList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
        </StackPanel>

        <TextBlock x:Name="NewLabel" Text="または新しいグループ名" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" KeyDown="NameBox_KeyDown"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" MinWidth="90" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="割り当てる" Click="Ok_Click" MinWidth="110" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
