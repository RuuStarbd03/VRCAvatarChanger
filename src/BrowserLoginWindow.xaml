<Window x:Class="VRCAvatarChanger.BrowserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource {x:Type Window}}"
        Title="VRChat にログイン" Height="780" Width="560" MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="いつもの方法で VRChat にログインしてください" FontWeight="SemiBold"/>
                <TextBlock Text="Discord、Google、Apple、Steam などの連携ログインが使えます。ログインが完了すると、このウィンドウは自動で閉じます。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource FaintTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
    </Grid>
</Window>
