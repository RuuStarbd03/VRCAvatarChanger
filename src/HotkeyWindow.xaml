<Window x:Class="VRCAvatarChanger.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="ホットキー" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Text="VRChat をプレイ中(VRChat が手前にあるとき)だけ反応します。押されたキーは VRChat には渡しません。"/>
        <TextBlock x:Name="DisabledWarning" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Text="設定の「クイック着替え / ホットキー」がオフのため、今はどのキーも反応しません。"/>

        <StackPanel x:Name="ActionRows" Margin="0,14,0,0"/>

        <TextBlock Text="アバターを直接指定" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
        <TextBlock x:Name="AvatarHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AvatarRows"/>
        </ScrollViewer>

        <TextBlock x:Name="CaptureHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="「変更」を押してから、使いたいキーの組み合わせを押してください(Esc で中止、Backspace で解除)。"/>

        <Button Content="閉じる" Click="Close_Click" MinWidth="100" Height="34" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
