<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <!-- 面 -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#FF141416"/>
    <SolidColorBrush x:Key="PanelBrush"       Color="#FF1C1C1F"/>
    <SolidColorBrush x:Key="InputBrush"       Color="#FF111113"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#FF2B2B31"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF3A3A42"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#FF242428"/>
    <SolidColorBrush x:Key="PressedBrush"     Color="#FF2A2A2F"/>
    <SolidColorBrush x:Key="SelectionBrush"   Color="#FF27415C"/>
    <SolidColorBrush x:Key="SegmentCheckedBrush" Color="#FF2C2C32"/>
    <SolidColorBrush x:Key="SkeletonBrush"    Color="#FF25252A"/>
    <SolidColorBrush x:Key="ThumbBackBrush"   Color="#FF0E0E10"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush"        Color="#FFE8E8EB"/>
    <SolidColorBrush x:Key="MutedTextBrush"   Color="#FF9C9CA6"/>
    <SolidColorBrush x:Key="FaintTextBrush"   Color="#FF6C6C76"/>

    <!-- アクセント(1 色) -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#FF3E8FD0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#FF4A9ADA"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF2F7AB8"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFF6FAFE"/>

    <!-- 意味色 -->
    <SolidColorBrush x:Key="DangerBrush"      Color="#FFE07A7E"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#FF6FBF8E"/>

    <!-- オーバーレイの背景 (設定パネルなど) -->
    <SolidColorBrush x:Key="ScrimBrush"       Color="#8C000000"/>
</ResourceDictionary>
