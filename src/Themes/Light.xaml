<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>

    <!-- 面 -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#FFF3F3F5"/>
    <SolidColorBrush x:Key="PanelBrush"       Color="#FFFCFCFD"/>
    <SolidColorBrush x:Key="InputBrush"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#FFDEDEE3"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFC9C9D0"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#FFEFEFF3"/>
    <SolidColorBrush x:Key="PressedBrush"     Color="#FFE6E6EB"/>
    <SolidColorBrush x:Key="SelectionBrush"   Color="#FFCBE2F6"/>
    <SolidColorBrush x:Key="SegmentCheckedBrush" Color="#FFE4E4E9"/>
    <SolidColorBrush x:Key="SkeletonBrush"    Color="#FFE8E8EC"/>
    <SolidColorBrush x:Key="ThumbBackBrush"   Color="#FFE9E9EE"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush"        Color="#FF1B1B20"/>
    <SolidColorBrush x:Key="MutedTextBrush"   Color="#FF5F5F69"/>
    <SolidColorBrush x:Key="FaintTextBrush"   Color="#FF8E8E98"/>

    <!-- アクセント(1 色) -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#FF2F7CBF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#FF2A6FAB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF245F93"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFFFFFFF"/>

    <!-- 意味色 -->
    <SolidColorBrush x:Key="DangerBrush"      Color="#FFB8434A"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#FF2E7D4F"/>

    <!-- オーバーレイの背景 (設定パネルなど) -->
    <SolidColorBrush x:Key="ScrimBrush"       Color="#4D000000"/>
</ResourceDictionary>
